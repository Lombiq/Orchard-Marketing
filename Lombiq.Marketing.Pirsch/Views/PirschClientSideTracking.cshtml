@using Lombiq.Marketing.Pirsch.Services
@inject IPirschClientSideTrackingViewModelService PirschClientSideTrackingViewModelService

@{
    var viewModel = await PirschClientSideTrackingViewModelService.GetViewModelAsync();

    if (string.IsNullOrWhiteSpace(viewModel?.ClientSideCodeSnippet))
    {
        return;
    }
}

@Html.Raw(viewModel.ClientSideCodeSnippet)
