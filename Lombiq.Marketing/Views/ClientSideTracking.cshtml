@using Lombiq.Marketing.Models
@using Lombiq.Marketing.Services
@using System.Linq
@inject IClientSideTrackingMarkupService ClientSideTrackingMarkupService

@{
    var viewModels = Model?.ViewModels as IEnumerable<ClientSideTrackingViewModel> ??
        await ClientSideTrackingMarkupService.GetViewModelsAsync();
    var renderedViewModels = viewModels.Where(viewModel => !string.IsNullOrWhiteSpace(viewModel.Html)).ToList();

    if (renderedViewModels.Count == 0)
    {
        return;
    }
}

@foreach (var viewModel in renderedViewModels)
{
    @Html.Raw(viewModel.Html)
}
